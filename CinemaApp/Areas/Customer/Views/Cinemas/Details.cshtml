@model List<Movie>
@{
    var cinema = (Cinema)ViewBag.Cinema;
    ViewData["Title"] = cinema.Name;
}

<main>
    <div class="section-head">
        <h2>@cinema.Name</h2>
        <p>Movies showing at this cinema.</p>
    </div>

    @if (!Model.Any())
    {
        <p class="empty">No movies are showing at this cinema right now.</p>
    }

    <div class="movie-grid">
        @foreach (var m in Model)
        {
            <a class="movie" asp-controller="Home" asp-action="Details" asp-route-id="@m.Id">
                <div class="poster">
                    <img loading="lazy" src="@m.PosterUrl()" alt="@m.Name poster" />
                    <span class="tag">@m.Category?.Name</span>
                    <span class="poster-rating">★ @m.Rating()</span>
                </div>
                <h3>@m.Name</h3>
                <div class="sub">@m.ShowDateTime.ToString("dd MMM, hh:mm tt") · @m.Price.ToString("0.##")</div>
            </a>
        }
    </div>

    <a class="btn btn-secondary mt-4" asp-action="Index">← All cinemas</a>
</main>