@model BookingFormViewModel

<div class="mb-3">
    <label asp-for="CustomerName" class="form-label"></label>
    <input asp-for="CustomerName" class="form-control" placeholder="Your full name" />
    <span asp-validation-for="CustomerName" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <input asp-for="Phone" class="form-control" placeholder="01XXXXXXXXX"
           readonly="@(Model.Id != 0)" />
    <span asp-validation-for="Phone" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="NumberOfTickets" class="form-label"></label>
    <input asp-for="NumberOfTickets" class="form-control" min="1" max="10" />
    <span asp-validation-for="NumberOfTickets" class="text-danger small"></span>
</div>

<div class="mb-4">
    <label asp-for="MovieId" class="form-label"></label>
    <select asp-for="MovieId" asp-items="(SelectList)ViewBag.Movies" class="form-select">
        <option value="0">-- Choose a movie --</option>
    </select>
    <span asp-validation-for="MovieId" class="text-danger small"></span>
</div>