@{
    ViewData["Title"] = "Find Booking";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0"><span class="fas fa-search me-2"></span>Manage my booking</h5>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Find" method="post">
                    <div class="mb-3">
                        <label class="form-label">Booking number</label>
                        <input name="id" type="number" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input name="phone" class="form-control" required />
                    </div>
                    <button class="btn btn-primary w-100">Find</button>
                    <div class="text-center mt-3">
                        <a asp-action="Create">Back to booking</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>